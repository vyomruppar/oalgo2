# Copy to backend/.env. Every value is optional.

# SEC asks automated clients to identify themselves: "Your Name your-email@example.com".
# Without it www.sec.gov can refuse the ticker file during busy periods.
OALGO_SEC_USER_AGENT=

# Stocks per scan (most liquid first) and history depth
OALGO_SCAN_MAX_SYMBOLS=300
OALGO_PRICE_HISTORY_YEARS=12

# Daily scan time (UTC, weekdays). 22:30 UTC is after the US close all year.
OALGO_SCAN_CRON_HOUR_UTC=22
OALGO_SCAN_CRON_MINUTE=30
OALGO_SCHEDULER_ENABLED=true

# Optional e-mail alerts (high and critical severity). Never commit real credentials.
OALGO_SMTP_HOST=
OALGO_SMTP_PORT=587
OALGO_SMTP_USER=
OALGO_SMTP_PASSWORD=
OALGO_ALERT_EMAIL_TO=
